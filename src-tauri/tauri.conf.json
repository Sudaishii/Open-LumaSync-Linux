{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/refs/heads/main/schema.json",
  "productName": "snzhy-OpenSycnlights",
  "version": "0.1.0",
  "identifier": "com.snzhy.opensycnlights",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "snzhy-OpenSycnlights",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "snzhy-OpenSycnlights"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libhidapi-hidraw0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
